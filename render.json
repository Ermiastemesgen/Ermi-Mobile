{
  "services": [
    {
      "type": "web",
      "name": "ermi-mobile",
      "env": "node",
      "plan": "free",
      "buildCommand": "npm install",
      "startCommand": "node server.js",
      "autoDeploy": true,
      "branch": "main",
      "envVars": [
        {
          "key": "NODE_ENV",
          "value": "production"
        }
      ]
    }
  ]
}